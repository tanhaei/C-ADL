{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "C-ADL",
  "scopeName": "source.cadl",
  "patterns": [
    {
      "comment": "C-ADL top-level keywords",
      "match": "\\b(name|components|connectors|exogenous|causal_links|counterfactuals|description|version):",
      "name": "keyword.control.cadl"
    },
    {
      "comment": "Common property keys",
      "match": "\\b(id|source|target|prob|do|intervention|query|functional_form|distribution|type|failure|latency|timeout|available):",
      "name": "support.type.property-name.cadl"
    },
    {
      "comment": "Distributions and declared types",
      "match": "\\b(Bernoulli|Normal|Exponential|Uniform|LogNormal|Boolean|Real|Integer|Categorical)\\b",
      "name": "support.function.distribution.cadl"
    },
    {
      "comment": "do-operator",
      "match": "do\\([^\\)]*\\)",
      "name": "keyword.other.do-operator.cadl"
    },
    {
      "comment": "Probability and expectation queries",
      "match": "\\b(P|E)\\([^\\)]*\\)",
      "name": "variable.language.query.cadl"
    },
    {
      "comment": "Causal arrow syntax",
      "match": "->",
      "name": "keyword.operator.arrow.cadl"
    },
    {
      "comment": "Comments",
      "match": "#.*$",
      "name": "comment.line.number-sign.cadl"
    },
    {
      "comment": "Numeric values",
      "match": "\\b\\d+(\\.\\d+)?(ms|s|%)?\\b",
      "name": "constant.numeric.cadl"
    }
  ]
}
