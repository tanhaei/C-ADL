name: SmartHome-IoT-Gateway
version: 2.0

description: >
  IoT edge benchmark with explicit exogenous interference, probabilistic failure
  propagation, and one structural-only continuous latency path.

components:
  - id: sensor_cluster_temp
    failure: Bernoulli(0.02)

  - id: sensor_cluster_motion
    failure: Bernoulli(0.01)

  - id: edge_gateway_broker
    queue_overflow: Bernoulli(0.05)
    data_loss: Bernoulli(0.03)
    processing_latency: Normal(15,5) ms

  - id: cloud_uplink_service
    timeout: Bernoulli(0.04)

exogenous:
  - id: rf_interference
    distribution: Bernoulli(0.15)

  - id: firmware_update_process
    distribution: Bernoulli(0.01)

causal_links:
  - source: rf_interference
    target: sensor_cluster_temp.failure
    prob: 0.60

  - source: rf_interference
    target: sensor_cluster_motion.failure
    prob: 0.60

  - source: sensor_cluster_temp.failure
    target: edge_gateway_broker.data_loss
    prob: 0.85

  - source: sensor_cluster_motion.failure
    target: edge_gateway_broker.data_loss
    prob: 0.85

  - source: edge_gateway_broker.data_loss
    target: cloud_uplink_service.timeout
    prob: 0.80

  - source: firmware_update_process
    target: edge_gateway_broker.processing_latency
    do: do(firmware_update_process=true) -> edge_gateway_broker.processing_latency=Normal(500,100) ms

counterfactuals:
  - id: cf_wired_connection
    intervention: do(rf_interference=false)
    query: P(edge_gateway_broker.data_loss | rf_interference=true)

  - id: structural_latency_review
    intervention: do(firmware_update_process=true)
    query: E(edge_gateway_broker.processing_latency | do(firmware_update_process=true))
