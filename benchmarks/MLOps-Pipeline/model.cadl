name: Enterprise-MLOps-Pipeline
version: 2.2

description: >
  Enterprise MLOps benchmark with explicit exogenous drift/contention,
  training instability, stale deployment, and serving degradation.

components:
  - id: data_ingestion
    failure: Bernoulli(0.01)

  - id: feature_store
    stale_features: Bernoulli(0.02)

  - id: training
    failure: Bernoulli(0.08)

  - id: model_serving
    stale_model: Bernoulli(0.03)
    degraded_accuracy: Bernoulli(0.05)
    latency: Normal(80,20) ms

exogenous:
  - id: sudden_data_drift
    distribution: Bernoulli(0.05)

  - id: cluster_resource_contention
    distribution: Bernoulli(0.20)

causal_links:
  - source: sudden_data_drift
    target: training.failure
    prob: 0.70
    description: Drift drives unstable gradients and failed retraining.

  - source: cluster_resource_contention
    target: training.failure
    prob: 0.85
    description: Contention leads to OOM and job crashes.

  - source: training.failure
    target: model_serving.stale_model
    prob: 1.00

  - source: sudden_data_drift
    target: model_serving.degraded_accuracy
    prob: 0.75

  - source: model_serving.stale_model
    target: model_serving.degraded_accuracy
    prob: 0.80

  - source: sudden_data_drift
    target: model_serving.latency
    do: do(sudden_data_drift=true) -> model_serving.latency=Exponential(300)

counterfactuals:
  - id: q_training_if_cluster_isolated
    query: P(training.failure | do(cluster_resource_contention=false))

  - id: cf_bad_prediction
    intervention: do(cluster_resource_contention=false)
    query: P(training.failure | training.failure=true)
