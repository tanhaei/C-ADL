name: TrainTicket-Causal-Model
version: 2.0

description: >
  Benchmark-aligned TrainTicket excerpt with typed architectural properties,
  one exogenous confounder, and executable intervention/counterfactual queries.

components:
  - id: auth
    failure: Bernoulli(0.002)
    latency: Normal(120,30) ms

  - id: order
    db_timeout: Bernoulli(0.01)
    failure: Bernoulli(0.001)

  - id: ui
    login_latency: Real ms
    timeout: Bernoulli(0.02)

  - id: payment
    available: Bernoulli(0.999)

exogenous:
  - id: network_partition
    distribution: Bernoulli(0.0005)

causal_links:
  - source: network_partition
    target: order.db_timeout
    prob: 0.70
    description: Shared network impairment drives downstream DB timeouts.

  - source: auth.failure
    target: ui.timeout
    prob: 0.95
    description: Authentication retries push the UI into timeout.

  - source: order.db_timeout
    target: order.failure
    prob: 0.90

  - source: payment.available
    target: order.failure
    prob: 0.05
    description: Payment availability weakly protects against order failures.

  - source: auth.failure
    target: ui.login_latency
    do: do(auth.failure=true) -> ui.login_latency=Exponential(8000)

counterfactuals:
  - id: q_ui_timeout_if_auth_fails
    query: P(ui.timeout | do(auth.failure=true))

  - id: cf_auth_healthy
    intervention: do(auth.failure=false)
    query: P(ui.timeout | auth.failure=true)
